DATABASE_URL="postgresql://user:password@localhost:5432/almash?schema=public"
JWT_SECRET="change-me"
SESSION_COOKIE="toyswap_session"
PORT=3001
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Public https URL of the Mini App — enables the "Open" button in Telegram messages
TELEGRAM_WEBAPP_URL=""
COOKIE_SECURE="false"
# Optional: folder with a built SPA (index.html). Default: ./public
# FRONTEND_DIST=""

# Background jobs interval (ms). 0 = off.
JOBS_INTERVAL_MS=300000
# In production: NODE_ENV=production, JWT_SECRET 32+ chars, TELEGRAM_BOT_TOKEN set.
# NODE_ENV="production"
