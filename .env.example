# Copy to backend/.env
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
SESSION_COOKIE="toyswap_session"
PORT=3001

# Telegram bot from @BotFather. Needed for Mini App HMAC and Login Widget.
TELEGRAM_BOT_TOKEN=""
# Username without @, e.g. swaptoy_bot
TELEGRAM_BOT_USERNAME=""
# Set true behind HTTPS so Mini App cookies work in Telegram WebView
COOKIE_SECURE="false"
