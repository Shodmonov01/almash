generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  telegramId       String?  @unique
  name             String
  username         String?  @unique
  avatarUrl        String?
  city             String
  district         String?
  bio              String?
  role             String   @default("USER") // USER | ADMIN
  status           String   @default("ACTIVE") // ACTIVE | WARNED | LIMITED | BLOCKED
  trustLevel       String   @default("NEW") // NEW | VERIFIED | RELIABLE | TRUSTED
  rating           Float    @default(0)
  ratingCount      Int      @default(0)
  completedTrades  Int      @default(0)
  cancelledTrades  Int      @default(0)
  noShowCount      Int      @default(0)
  disputesCount    Int      @default(0)
  disputesWon      Int      @default(0)
  disputesLost     Int      @default(0)
  warningCount     Int      @default(0)
  moneyViolations  Int      @default(0)
  riskScoreCached  Int      @default(0)
  onboardingDone   Boolean  @default(false)
  deviceFingerprint String?
  lastIp           String?
  telegramAuthDate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            Item[]
  favorites        Favorite[]
  tradeParties     TradeParty[]
  messages         Message[]
  reviewsAuthored  Review[]  @relation("ReviewAuthor")
  reviewsReceived  Review[]  @relation("ReviewTarget")
  disputesOpened   Dispute[] @relation("DisputeOpener")
  reportsFiled     Report[]  @relation("ReportAuthor")
  reportsAgainst   Report[]  @relation("ReportTarget")
  riskEvents       RiskEvent[]
  auditLogs        AuditLog[]
  notifications    Notification[]
}

model Item {
  id              String   @id @default(cuid())
  ownerId         String
  title           String
  description     String
  category        String
  subcategory     String?
  brand           String?
  model           String?
  ageFrom         Int?
  ageTo           Int?
  condition       String
  completeness    String?
  hasDamage       Boolean  @default(false)
  damageNotes     String?
  missingParts    String?
  isOriginal      Boolean  @default(true)
  size            String?
  color           String?
  tags            String? // JSON array as string
  city            String
  district        String?
  radiusKm        Int      @default(10)
  status          String   @default("ACTIVE") // ACTIVE | IN_TRADE | TRADED | HIDDEN | BLOCKED | PENDING_MODERATION
  wantType        String   @default("ANY") // SPECIFIC | CATEGORY | BRAND | ANY
  wantText        String?
  wantCategories  String? // JSON
  wantBrands      String? // JSON
  defectsConfirmed Boolean @default(false)
  serialNumber    String?
  snapshotJson    String? // frozen snapshot when trade starts
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation(fields: [ownerId], references: [id])
  media           ItemMedia[]
  favorites       Favorite[]
  tradeItems      TradeItem[]
  setItems        SetItem[]

  @@index([ownerId])
  @@index([category, city, status])
  @@index([brand])
}

model ItemMedia {
  id          String   @id @default(cuid())
  itemId      String
  type        String   @default("PHOTO") // PHOTO | VIDEO
  url         String
  hash        String?
  phash       String?
  watermarked Boolean  @default(false)
  width       Int?
  height      Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([hash])
  @@index([phash])
  @@index([itemId])
}

model ItemSet {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  items       SetItem[]
}

model SetItem {
  id     String @id @default(cuid())
  setId  String
  itemId String

  set    ItemSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([setId, itemId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Trade {
  id              String    @id @default(cuid())
  publicId        String    @unique // EX-2026-000123
  status          String    @default("DRAFT")
  // DRAFT OFFER_SENT NEGOTIATION TERMS_AGREED MEETING_SCHEDULED
  // HANDOFF_PENDING PARTY_A_CONFIRMED PARTY_B_CONFIRMED COMPLETED
  // DISPUTED CANCELLED BLOCKED EXPIRED
  initiatorId     String
  recipientId     String
  currentVersion  Int       @default(1)
  meetingAt       DateTime?
  meetingPlace    String?
  meetingNotes    String?
  confirmCodeA    String?
  confirmCodeB    String?
  qrToken         String?
  codeAUsedAt     DateTime?
  codeBUsedAt     DateTime?
  qrUsedAt        DateTime?
  partyAConfirmedAt DateTime?
  partyBConfirmedAt DateTime?
  termsLockedAt   DateTime?
  expiresAt       DateTime?
  cancelledById   String?
  cancelReason    String?
  riskScore       Int       @default(0)
  reminder24Sent  Boolean   @default(false)
  reminder2Sent   Boolean   @default(false)
  handoffReminderSent Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parties         TradeParty[]
  items           TradeItem[]
  versions        TradeVersion[]
  messages        Message[]
  reviews         Review[]
  disputes        Dispute[]
  reports         Report[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([status])
  @@index([initiatorId])
  @@index([recipientId])
}

model TradeParty {
  id        String   @id @default(cuid())
  tradeId   String
  userId    String
  side      String // A | B
  confirmedTerms Boolean @default(false)
  viewedItemsAck Boolean @default(false)
  noShowReported Boolean @default(false)

  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tradeId, userId])
  @@unique([tradeId, side])
}

model TradeItem {
  id        String @id @default(cuid())
  tradeId   String
  itemId    String
  ownerId   String
  side      String // A | B
  version   Int    @default(1)
  itemSnapshot String? // JSON snapshot of item at lock time

  trade     Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  item      Item   @relation(fields: [itemId], references: [id])

  @@index([tradeId, version])
}

model TradeVersion {
  id          String   @id @default(cuid())
  tradeId     String
  version     Int
  payloadJson String
  createdById String
  note        String?
  createdAt   DateTime @default(now())

  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, version])
}

model Message {
  id             String   @id @default(cuid())
  tradeId        String
  senderId       String
  body           String
  mediaUrl       String?
  flagged        Boolean  @default(false)
  flagReason     String?
  system         Boolean  @default(false)
  createdAt      DateTime @default(now())

  trade          Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id])

  @@index([tradeId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  tradeId   String
  authorId  String
  targetId  String
  rating    Int
  tags      String? // JSON
  text      String?
  createdAt DateTime @default(now())

  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([tradeId, authorId])
}

model Dispute {
  id           String   @id @default(cuid())
  tradeId      String
  openedById   String
  reason       String
  description  String
  evidenceJson String? // JSON links/notes
  status       String   @default("OPEN") // OPEN | IN_REVIEW | RESOLVED_A | RESOLVED_B | RETURNED | CLOSED
  resolution   String?
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trade        Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  openedBy     User     @relation("DisputeOpener", fields: [openedById], references: [id])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetUserId String?
  itemId       String?
  tradeId      String?
  reason       String
  description  String?
  status       String   @default("OPEN") // OPEN | REVIEWED | ACTION_TAKEN | DISMISSED
  createdAt    DateTime @default(now())

  reporter     User     @relation("ReportAuthor", fields: [reporterId], references: [id])
  targetUser   User?    @relation("ReportTarget", fields: [targetUserId], references: [id])
  trade        Trade?   @relation(fields: [tradeId], references: [id])
}

model RiskEvent {
  id        String   @id @default(cuid())
  userId    String?
  tradeId   String?
  type      String
  score     Int      @default(0)
  detail    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tradeId   String?
  action    String
  metaJson  String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  trade     Trade?   @relation(fields: [tradeId], references: [id])

  @@index([tradeId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  tradeId   String?
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade     Trade?   @relation(fields: [tradeId], references: [id])

  @@index([userId, read])
}

model ForbiddenCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  enabled   Boolean @default(true)
}

model ModerationQueue {
  id          String   @id @default(cuid())
  type        String   // DUPLICATE_PHOTO | MONEY_LISTING | HIGH_RISK_USER | SUSPICIOUS_TRADE
  status      String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  itemId      String?
  userId      String?
  tradeId     String?
  mediaHash   String?
  detail      String?
  score       Int      @default(0)
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([status, type])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([key])
}
